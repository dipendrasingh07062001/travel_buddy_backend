NODE_ENV=development
HOST=0.0.0.0
PORT=3000
# Behind a load balancer or reverse proxy, set the number of proxy hops (usually 1)
# or a comma-separated list of proxy IPs/CIDRs so rate limits see each client's IP.
# Leave unset when clients connect directly. Never use true on a directly reachable server.
# TRUST_PROXY=1
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
DATABASE_URL=postgresql://travel_buddy:travel_buddy@localhost:5432/travel_buddy
# FIREBASE_PROJECT_ID=your-firebase-project-id
# Absolute path to a Firebase service-account JSON file stored outside this repository.
# Required wherever people sign in: sign-in, data requests and export, and staff
# routes ask Firebase for the account's current state and return 503 without it.
# Push notifications and deleting erased accounts' Firebase logins need it too.
# On hosts with workload identity, that can replace this file.
# GOOGLE_APPLICATION_CREDENTIALS=C:\absolute\path\to\service-account.json
# Alternative for hosts with secret variables (for example Railway): set the
# complete, original service-account JSON as one private/sealed variable.
# This takes precedence over ADC; invalid JSON never falls back to another key.
# Do not put a real value in this file, Git, Docker build arguments or Flutter.
# FIREBASE_SERVICE_ACCOUNT_JSON=
# See docs/firebase-hosted-credentials.md for hosted and Docker file-mount setup.
# Push notifications through Firebase Cloud Messaging.
PUSH_NOTIFICATIONS_ENABLED=false
# Cloudflare R2 file storage for profile photos (public bucket) and receipts
# (private bucket). Configure all six together; see "File storage" in README.md.
# R2_ACCOUNT_ID=your-32-character-cloudflare-account-id
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_PUBLIC_BUCKET=travel-buddy-public
# R2_PRIVATE_BUCKET=travel-buddy-private
# R2_PUBLIC_BASE_URL=https://media.your-domain.example
# Leave all policy settings unset until approved documents are published.
# Configure all six together; URLs must use HTTPS. Never point to draft or placeholder text.
# POLICY_TERMS_VERSION=2026-10
# POLICY_TERMS_URL=https://your-domain.example/terms
# POLICY_PRIVACY_VERSION=2026-10
# POLICY_PRIVACY_URL=https://your-domain.example/privacy
# POLICY_COMMUNITY_STANDARDS_VERSION=2026-10
# POLICY_COMMUNITY_STANDARDS_URL=https://your-domain.example/community-standards
