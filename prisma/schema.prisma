generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum IdentityType {
  EMAIL
  PHONE
}

enum AuthProvider {
  FIREBASE
}

enum ProfileVisibility {
  PUBLIC
  MEMBERS_ONLY
  PRIVATE
}

enum PolicyType {
  TERMS
  PRIVACY
  COMMUNITY_STANDARDS
}

enum CommunityStatus {
  ACTIVE
  ARCHIVED
}

enum TripStatus {
  DRAFT
  PUBLISHED
  PAUSED
  FULL
  COMPLETED
  CANCELLED
}

enum TripTransport {
  BUS
  TRAIN
  FLIGHT
  CAR
  MOTORCYCLE
  OTHER
  UNDECIDED
}

enum ConnectionRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
  WITHDRAWN
  BLOCKED
}

enum TripMembershipRole {
  OWNER
  MEMBER
}

enum TripMembershipStatus {
  ACTIVE
  LEFT
  REMOVED
}

enum ReportTargetType {
  USER
  TRIP
  CONNECTION_REQUEST
  MESSAGE
}

enum ReportReason {
  HARASSMENT
  HATE_OR_THREATS
  SEXUAL_SOLICITATION
  SCAM_OR_FRAUD
  IMPERSONATION
  COMMERCIAL_TOUR_SPAM
  PRIVACY_VIOLATION
  OTHER
}

enum ReportStatus {
  SUBMITTED
  UNDER_REVIEW
  ACTIONED
  DISMISSED
}

enum MessageStatus {
  ACTIVE
  EDITED
  DELETED
}

enum MessageRevisionAction {
  EDIT
  DELETE
}

model User {
  id                         String                    @id @default(uuid()) @db.Uuid
  status                     UserStatus                @default(ACTIVE)
  displayName                String?                   @map("display_name") @db.VarChar(100)
  birthDate                  DateTime?                 @map("birth_date") @db.Date
  profile                    UserProfile?
  authAccounts               AuthAccount[]
  identities                 AuthIdentity[]
  policyAcceptances          PolicyAcceptance[]
  trips                      Trip[]
  sentConnectionRequests     ConnectionRequest[]       @relation("ConnectionRequester")
  receivedConnectionRequests ConnectionRequest[]       @relation("ConnectionRecipient")
  decidedConnectionRequests  ConnectionRequest[]       @relation("ConnectionDecider")
  tripMemberships            TripMembership[]
  blocksCreated              UserBlock[]               @relation("Blocker")
  blocksReceived             UserBlock[]               @relation("Blocked")
  reportsSubmitted           Report[]                  @relation("ReportReporter")
  reportsReceived            Report[]                  @relation("ReportUserTarget")
  conversationStates         ConversationParticipant[]
  messages                   Message[]
  messageRevisions           MessageRevision[]         @relation("MessageRevisionEditor")
  createdAt                  DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                  DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt                  DateTime?                 @map("deleted_at") @db.Timestamptz(6)

  @@index([status])
  @@map("users")
}

model UserProfile {
  userId                      String            @id @map("user_id") @db.Uuid
  profilePhotoStorageKey      String?           @map("profile_photo_storage_key") @db.VarChar(500)
  homeCity                    String?           @map("home_city") @db.VarChar(120)
  homeRegion                  String?           @map("home_region") @db.VarChar(120)
  biography                   String?           @db.VarChar(500)
  languages                   String[]          @default([])
  travelInterests             String[]          @default([]) @map("travel_interests")
  pastTripsVisibility         ProfileVisibility @default(MEMBERS_ONLY) @map("past_trips_visibility")
  communityActivityVisibility ProfileVisibility @default(PUBLIC) @map("community_activity_visibility")
  createdAt                   DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                   DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  user                        User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([homeCity])
  @@map("user_profiles")
}

model AuthAccount {
  id              String       @id @default(uuid()) @db.Uuid
  userId          String       @map("user_id") @db.Uuid
  provider        AuthProvider
  providerSubject String       @map("provider_subject") @db.VarChar(128)
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSubject])
  @@index([userId])
  @@map("auth_accounts")
}

model Community {
  id          String          @id @default(uuid()) @db.Uuid
  slug        String          @unique @db.VarChar(120)
  name        String          @db.VarChar(120)
  region      String?         @db.VarChar(120)
  countryCode String          @default("IN") @map("country_code") @db.Char(2)
  description String?
  status      CommunityStatus @default(ACTIVE)
  trips       Trip[]
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([status, name])
  @@map("communities")
}

model Trip {
  id                        String              @id @default(uuid()) @db.Uuid
  ownerId                   String              @map("owner_id") @db.Uuid
  communityId               String              @map("community_id") @db.Uuid
  originCity                String              @map("origin_city") @db.VarChar(120)
  startDate                 DateTime            @map("start_date") @db.Date
  endDate                   DateTime            @map("end_date") @db.Date
  flexibilityDays           Int                 @default(0) @map("flexibility_days")
  durationDays              Int                 @map("duration_days")
  budgetMin                 Decimal?            @map("budget_min") @db.Decimal(12, 2)
  budgetMax                 Decimal?            @map("budget_max") @db.Decimal(12, 2)
  currency                  String              @default("INR") @db.Char(3)
  currentGroupSize          Int                 @default(1) @map("current_group_size")
  desiredGroupSize          Int                 @map("desired_group_size")
  transport                 TripTransport       @default(UNDECIDED)
  description               String
  status                    TripStatus          @default(DRAFT)
  version                   Int                 @default(1)
  publishedAt               DateTime?           @map("published_at") @db.Timestamptz(6)
  owner                     User                @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  community                 Community           @relation(fields: [communityId], references: [id], onDelete: Restrict)
  connectionRequests        ConnectionRequest[] @relation("ConnectionTargetTrip")
  relatedConnectionRequests ConnectionRequest[] @relation("ConnectionRelatedTrip")
  memberships               TripMembership[]
  reports                   Report[]
  conversation              Conversation?
  createdAt                 DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([status, startDate])
  @@index([communityId, status, startDate])
  @@index([ownerId])
  @@index([originCity])
  @@map("trips")
}

model ConnectionRequest {
  id            String                  @id @default(uuid()) @db.Uuid
  tripId        String                  @map("trip_id") @db.Uuid
  requesterId   String                  @map("requester_id") @db.Uuid
  recipientId   String                  @map("recipient_id") @db.Uuid
  relatedTripId String?                 @map("related_trip_id") @db.Uuid
  message       String                  @db.VarChar(500)
  status        ConnectionRequestStatus @default(PENDING)
  decidedById   String?                 @map("decided_by_id") @db.Uuid
  decidedAt     DateTime?               @map("decided_at") @db.Timestamptz(6)
  withdrawnAt   DateTime?               @map("withdrawn_at") @db.Timestamptz(6)
  trip          Trip                    @relation("ConnectionTargetTrip", fields: [tripId], references: [id], onDelete: Cascade)
  relatedTrip   Trip?                   @relation("ConnectionRelatedTrip", fields: [relatedTripId], references: [id], onDelete: SetNull)
  requester     User                    @relation("ConnectionRequester", fields: [requesterId], references: [id], onDelete: Restrict)
  recipient     User                    @relation("ConnectionRecipient", fields: [recipientId], references: [id], onDelete: Restrict)
  decidedBy     User?                   @relation("ConnectionDecider", fields: [decidedById], references: [id], onDelete: Restrict)
  membership    TripMembership?
  reports       Report[]
  createdAt     DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([tripId, requesterId])
  @@index([recipientId, status, createdAt])
  @@index([requesterId, status, createdAt])
  @@map("connection_requests")
}

model TripMembership {
  id                  String               @id @default(uuid()) @db.Uuid
  tripId              String               @map("trip_id") @db.Uuid
  userId              String               @map("user_id") @db.Uuid
  connectionRequestId String?              @unique @map("connection_request_id") @db.Uuid
  role                TripMembershipRole
  status              TripMembershipStatus @default(ACTIVE)
  joinedAt            DateTime             @default(now()) @map("joined_at") @db.Timestamptz(6)
  leftAt              DateTime?            @map("left_at") @db.Timestamptz(6)
  removedAt           DateTime?            @map("removed_at") @db.Timestamptz(6)
  trip                Trip                 @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user                User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  connectionRequest   ConnectionRequest?   @relation(fields: [connectionRequestId], references: [id], onDelete: SetNull)
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([tripId, userId])
  @@index([userId, status])
  @@index([tripId, status])
  @@map("trip_memberships")
}

model Conversation {
  id           String                    @id @default(uuid()) @db.Uuid
  tripId       String                    @unique @map("trip_id") @db.Uuid
  trip         Trip                      @relation(fields: [tripId], references: [id], onDelete: Cascade)
  participants ConversationParticipant[]
  messages     Message[]
  createdAt    DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("conversations")
}

model ConversationParticipant {
  conversationId String       @map("conversation_id") @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  lastReadAt     DateTime?    @map("last_read_at") @db.Timestamptz(6)
  mutedAt        DateTime?    @map("muted_at") @db.Timestamptz(6)
  joinedAt       DateTime     @default(now()) @map("joined_at") @db.Timestamptz(6)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([conversationId, userId])
  @@index([userId])
  @@map("conversation_participants")
}

model Message {
  id             String            @id @default(uuid()) @db.Uuid
  conversationId String            @map("conversation_id") @db.Uuid
  senderId       String            @map("sender_id") @db.Uuid
  body           String            @db.VarChar(2000)
  status         MessageStatus     @default(ACTIVE)
  editedAt       DateTime?         @map("edited_at") @db.Timestamptz(6)
  deletedAt      DateTime?         @map("deleted_at") @db.Timestamptz(6)
  conversation   Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User              @relation(fields: [senderId], references: [id], onDelete: Restrict)
  revisions      MessageRevision[]
  reports        Report[]
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([conversationId, createdAt, id])
  @@index([senderId, createdAt])
  @@map("messages")
}

model MessageRevision {
  id           String                @id @default(uuid()) @db.Uuid
  messageId    String                @map("message_id") @db.Uuid
  editorId     String                @map("editor_id") @db.Uuid
  action       MessageRevisionAction
  previousBody String                @map("previous_body") @db.VarChar(2000)
  message      Message               @relation(fields: [messageId], references: [id], onDelete: Cascade)
  editor       User                  @relation("MessageRevisionEditor", fields: [editorId], references: [id], onDelete: Restrict)
  createdAt    DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([messageId, createdAt])
  @@map("message_revisions")
}

model UserBlock {
  blockerId String   @map("blocker_id") @db.Uuid
  blockedId String   @map("blocked_id") @db.Uuid
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@id([blockerId, blockedId])
  @@index([blockedId])
  @@map("user_blocks")
}

model Report {
  id                          String             @id @default(uuid()) @db.Uuid
  reporterId                  String             @map("reporter_id") @db.Uuid
  targetType                  ReportTargetType   @map("target_type")
  reportedUserId              String?            @map("reported_user_id") @db.Uuid
  reportedTripId              String?            @map("reported_trip_id") @db.Uuid
  reportedConnectionRequestId String?            @map("reported_connection_request_id") @db.Uuid
  reportedMessageId           String?            @map("reported_message_id") @db.Uuid
  reason                      ReportReason
  details                     String?            @db.VarChar(1000)
  status                      ReportStatus       @default(SUBMITTED)
  reporter                    User               @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Restrict)
  reportedUser                User?              @relation("ReportUserTarget", fields: [reportedUserId], references: [id], onDelete: Restrict)
  reportedTrip                Trip?              @relation(fields: [reportedTripId], references: [id], onDelete: Restrict)
  reportedConnectionRequest   ConnectionRequest? @relation(fields: [reportedConnectionRequestId], references: [id], onDelete: Restrict)
  reportedMessage             Message?           @relation(fields: [reportedMessageId], references: [id], onDelete: Restrict)
  createdAt                   DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                   DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([reporterId, status, createdAt])
  @@index([reportedUserId])
  @@index([reportedTripId])
  @@index([reportedConnectionRequestId])
  @@index([reportedMessageId])
  @@map("reports")
}

model AuthIdentity {
  id              String       @id @default(uuid()) @db.Uuid
  userId          String       @map("user_id") @db.Uuid
  type            IdentityType
  normalizedValue String       @map("normalized_value") @db.VarChar(320)
  verifiedAt      DateTime?    @map("verified_at") @db.Timestamptz(6)
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([type, normalizedValue])
  @@index([userId])
  @@map("auth_identities")
}

model PolicyAcceptance {
  id         String     @id @default(uuid()) @db.Uuid
  userId     String     @map("user_id") @db.Uuid
  policyType PolicyType @map("policy_type")
  version    String     @db.VarChar(50)
  acceptedAt DateTime   @default(now()) @map("accepted_at") @db.Timestamptz(6)
  ipHash     String?    @map("ip_hash") @db.VarChar(128)
  user       User       @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([userId, policyType, version])
  @@index([policyType, version])
  @@map("policy_acceptances")
}
